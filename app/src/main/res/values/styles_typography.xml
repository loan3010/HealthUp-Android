        <item name="android:textSize">@dimen/text_size_sub_content</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:textColor">@color/neutral_dark_grey</item>
    </style>

    <style name="TextAppearance.HealthUp.SubContent.Bold">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/neutral_black</item>
    </style>

    <style name="TextAppearance.HealthUp.ButtonLarge" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
        <item name="android:textSize">@dimen/text_size_button_large</item>
