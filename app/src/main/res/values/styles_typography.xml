    </style>

    <!-- Dùng riêng cho label nav bar: Medium 10sp -->
    <style name="TextAppearance.HealthUp.NavLabel" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
        <item name="android:textSize">10sp</item>
    </style>

</resources>
