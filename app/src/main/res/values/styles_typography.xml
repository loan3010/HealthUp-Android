        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.HealthUp.EditText" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
        <item name="android:textSize">@dimen/text_size_edit_text</item>
