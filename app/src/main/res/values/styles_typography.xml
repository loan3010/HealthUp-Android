<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =====================================================
         2. TYPOGRAPHY — Be Vietnam Pro
         ===================================================== -->

    <style name="TextAppearance.HealthUp.Title" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/neutral_black</item>
    </style>

    <style name="TextAppearance.HealthUp.SubTitle" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
        <item name="android:textSize">@dimen/text_size_sub_title</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/neutral_black</item>
    </style>

    <style name="TextAppearance.HealthUp.Content" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
        <item name="android:textSize">@dimen/text_size_content</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/neutral_black</item>
    </style>

    <style name="TextAppearance.HealthUp.SubContent" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/be_vietnam_pro</item>
