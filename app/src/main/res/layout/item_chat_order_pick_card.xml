<?xml version="1.0" encoding="utf-8"?>
<!-- Compact selectable order card for the horizontal carousel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/orderPickRoot"
    android:layout_width="268dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_chat_order_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/orderPickThumb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/divider_color"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_chat_order" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/orderPickCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Đơn #ORD123" />

            <TextView
                android:id="@+id/orderPickProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Whey Protein Gold Standard" />
        </LinearLayout>

        <TextView
            android:id="@+id/orderPickStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_status_chip"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/brand_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Đã giao" />
    </LinearLayout>

    <TextView
        android:id="@+id/orderPickMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="2 sản phẩm · 580.000đ" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/orderPickButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:text="@string/chat_order_pick_button"
        android:textAllCaps="false"
        android:textSize="13sp" />
</LinearLayout>
