<?xml version="1.0" encoding="utf-8"?>
<!-- Left-aligned bubble used for bot and seller messages. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="64dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_bot_avatar">

        <ImageView
            android:id="@+id/chatBotAvatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/chat_avatar_desc"
            android:src="@drawable/ic_chat_bot" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chatSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Người bán"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/chatBotText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_bot"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            tools:text="Xin chào! Mình là trợ lý HealthUp"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/chatBotTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            tools:text="14:32"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

</LinearLayout>
