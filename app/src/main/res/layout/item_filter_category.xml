<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp">

    <!-- FIX: bỏ buttonTint/drawable tùy chỉnh, dùng đúng CheckBox mặc định
         giống hệt cbSelect trong item_product.xml (màn "Sản phẩm yêu thích" /
         Giỏ hàng chế độ chọn) để 2 nơi có ô tick đồng bộ với nhau. -->
    <CheckBox
        android:id="@+id/cb_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tv_category_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:text="Hạt dinh dưỡng"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_product_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_count_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="24"
        android:textColor="@color/text_gray"
        android:textSize="12sp" />

</LinearLayout>