<?xml version="1.0" encoding="utf-8"?>
<!-- FIX (khoảng trống bên phải card Blog): fragment_blog.xml dùng RecyclerView với
     LinearLayoutManager theo chiều DỌC (1 cột), không phải carousel ngang. Trước đây root
     layout_width bị đặt cứng "300dp" + layout_marginEnd="16dp" khiến mỗi card chỉ chiếm một
     phần chiều ngang màn hình, chừa lại khoảng trống bên phải. Sửa: layout_width="match_parent"
     và bỏ marginEnd (chỉ giữ marginBottom để giãn cách các card theo chiều dọc). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/neutral_white"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">




        <ImageView
            android:id="@+id/iv_blog_image"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">




            <TextView
                android:id="@+id/tv_blog_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_discount_tag"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Dinh dưỡng"
                android:textColor="@color/primary_green"
                android:textSize="12sp"
                android:textStyle="bold" />




            <TextView
                android:id="@+id/tv_blog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Top 10 thực phẩm giúp tăng cường hệ miễn dịch trong mùa dịch"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />




            <TextView
                android:id="@+id/tv_blog_excerpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="Việc duy trì một chế độ ăn uống khoa học là chìa khóa để bảo vệ sức khỏe của bạn và gia đình..."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />




            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#EFEFEF" />




            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">




                <TextView
                    android:id="@+id/tv_blog_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="12 tháng 10, 2023"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />




                <TextView
                    android:id="@+id/btn_read_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Đọc tiếp >"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>