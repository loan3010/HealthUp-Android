<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal">

    <!-- Icon Area (The Left Part) -->
    <LinearLayout
        android:id="@+id/layoutIcon"
        android:layout_width="80dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_card_white"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgType"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_order_shipping" />

        <TextView
            android:id="@+id/tvTypeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="FREESHIP"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Separator Line (Dash Effect) -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#DDDDDD" />

    <!-- Info Area (The Right Part) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_card_white"
        android:minHeight="100dp"
        android:orientation="vertical"
        android:gravity="start"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingEnd="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/rbSelected"
                android:layout_marginEnd="8dp"
                android:text="Miễn phí vận chuyển"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTitle"
                android:layout_alignParentStart="true"
                android:layout_marginTop="4dp"
                android:layout_toStartOf="@+id/rbSelected"
                android:layout_marginEnd="8dp"
                android:text="Đơn tối thiểu 100k"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbSelected"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="false"
                android:focusable="false" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Time"
                    android:src="@drawable/ic_order_pending"
                    app:tint="@color/text_gray_muted" />

                <TextView
                    android:id="@+id/tvExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="HSD: 30.06.2024"
                    android:textColor="@color/text_gray_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="CHI TIẾT"
                android:textColor="#36873A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- Tiết lộ lý do không dùng được voucher -->
        <TextView
            android:id="@+id/tvIneligibleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF5F5"
            android:padding="8dp"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:gravity="start"
            android:visibility="gone"
            tools:text="Mua thêm 50.000đ để sử dụng voucher này"
            tools:visibility="visible"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>
</LinearLayout>
