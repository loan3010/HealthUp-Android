<?xml version="1.0" encoding="utf-8"?>
<!-- Product context card: no avatar — not styled as an incoming chat bubble. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/productCardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_order_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/productCardImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@color/divider_color"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_image_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/productCardName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Whey Protein Gold" />

                <TextView
                    android:id="@+id/productCardVariant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Vị socola"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/productCardPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/brand_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="450.000đ" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/productCardActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProductAddCart"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/chat_product_add_cart"
                android:textAllCaps="false"
                android:textColor="@color/primary_default"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_tint_5"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_cart"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/primary_default"
                app:strokeColor="@color/primary_default" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProductBuyNow"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/chat_product_buy_now"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_default"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
