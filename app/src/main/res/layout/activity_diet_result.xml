<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:orientation="vertical">

    <include
        android:id="@+id/dietToolbar"
        layout="@layout/include_diet_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l">

            <LinearLayout
                android:id="@+id/sectionBmi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:background="@drawable/bg_card_white"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diet_bmi_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvBmiValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:textColor="@color/primary_default"
                    android:textSize="48sp"
                    tools:text="21.4" />

                <TextView
                    android:id="@+id/tvBmiBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:background="@drawable/bg_diet_history_badge"
                    android:paddingHorizontal="@dimen/spacing_l"
                    android:paddingVertical="6dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Bình thường" />

                <com.example.healthup.diet.BmiGaugeView
                    android:id="@+id/bmiGauge"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/spacing_l" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@drawable/bg_diet_info_box"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_l">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_about_icon_circle"
                    android:backgroundTint="@color/primary_tint_5"
                    android:padding="8dp"
                    android:src="@drawable/ic_leaf"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvBmiAdvice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="BMI trong khoảng bình thường..." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <TextView
                    android:id="@+id/tvBmrTdee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="BMR: 1400 kcal | TDEE: 1800 kcal" />

                <TextView
                    android:id="@+id/tvTargetKcal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:textColor="@color/primary_default"
                    android:textSize="15sp"
                    tools:text="Calo mục tiêu: ~1700 kcal/ngày" />

                <TextView
                    android:id="@+id/tvTierLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="Gợi ý mức: Nhẹ (1500 kcal)" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/diet_goal_label"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGiamCan"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diet_goal_lose"
                    app:chipStrokeColor="@color/primary_default"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDuyTri"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diet_goal_maintain"
                    app:chipStrokeColor="@color/primary_default"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTangCan"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diet_goal_gain"
                    app:chipStrokeColor="@color/primary_default"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvDoctorWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@drawable/bg_diet_info_box"
                android:drawablePadding="@dimen/spacing_s"
                android:padding="@dimen/spacing_l"
                android:text="@string/diet_doctor_warning"
                android:textColor="@color/status_amber"
                android:textSize="13sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_warning"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvUpdateMeasurements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:padding="@dimen/spacing_s"
                android:text="@string/diet_update_measurements"
                android:textColor="@color/primary_default"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="@dimen/spacing_l"
        android:backgroundTint="@color/primary_default"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/diet_view_recipes_cta"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="end"
        app:iconTint="@color/white" />
</LinearLayout>
