<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/neutral_white">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@color/neutral_light_grey" />

                <TextView
                    android:id="@+id/tvBadgeNew"
                    style="@style/Widget.HealthUp.Badge.New"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:text="MỚI"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvBadgeHot"
                    style="@style/Widget.HealthUp.Badge.Hot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:text="HOT"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvBadgeOutOfStock"
                    style="@style/Widget.HealthUp.Badge.OutOfStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:text="@string/out_of_stock"
                    android:visibility="gone" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:id="@+id/tvProductName"
            style="@style/TextAppearance.HealthUp.SubContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lines="2"
            android:text="Product Name"
            android:textColor="@color/neutral_black"
            android:textStyle="bold" />


        <LinearLayout
            android:id="@+id/layoutRatingSold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star"
                    app:tint="#FFB300"
                    android:layout_marginEnd="2dp"/>


                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5"
                    android:textSize="11sp"
                    android:textColor="@color/neutral_black"
                    android:textStyle="bold" />
            </LinearLayout>


            <TextView
                android:id="@+id/tvSoldCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="đã bán 100"
                android:textSize="11sp"
                android:textColor="@color/neutral_grey" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvProductPrice"
                    style="@style/TextAppearance.HealthUp.Content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="100.000đ"
                    android:textColor="@color/primary_default"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvOriginalPrice"
                    style="@style/TextAppearance.HealthUp.CaptionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120.000đ"
                    android:visibility="gone" />
            </LinearLayout>


            <!-- FIX: clickable=false + focusable=false để sự kiện chạm được truyền lên
                 itemView.setOnClickListener() thay vì bị CheckBox tự "nuốt" mất.
                 Đây là nguyên nhân khiến chọn/bỏ chọn không cập nhật được selectedProducts. -->
            <CheckBox
                android:id="@+id/cbSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone" />


            <ImageView
                android:id="@+id/btnWishlist"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_circle_light"
                android:padding="6dp"
                android:src="@drawable/ic_wishlist"
                app:tint="@color/primary_default" />


            <ImageView
                android:id="@+id/btnAddToCart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_green"
                android:padding="6dp"
                android:src="@drawable/ic_plus"
                app:tint="@color/neutral_white" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>