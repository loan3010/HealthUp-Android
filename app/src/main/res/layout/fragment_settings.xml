<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_cream"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">


        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">


            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_back"
                app:tint="@color/neutral_black" />


            <TextView
                style="@style/TextAppearance.HealthUp.SubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Thiết lập tài khoản"
                android:textColor="@color/neutral_black"
                android:textStyle="bold" />


            <ImageView
                android:id="@+id/btnChatSupport"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_circle_green"
                android:backgroundTint="@android:color/transparent"
                android:padding="8dp"
                android:src="@drawable/ic_chat_support"
                app:tint="@color/neutral_grey" />
        </RelativeLayout>


        <!-- Section: Tài khoản -->
        <TextView
            style="@style/TextAppearance.HealthUp.SubContent.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="Tài khoản" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <include
                    android:id="@+id/itemInfo"
                    layout="@layout/item_setting_row" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/neutral_light_grey" />


                <include
                    android:id="@+id/itemAddress"
                    layout="@layout/item_setting_row" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/neutral_light_grey" />


                <include
                    android:id="@+id/itemPayment"
                    layout="@layout/item_setting_row" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/neutral_light_grey" />


                <!-- FIX: Thêm mục Sản phẩm yêu thích -->
                <include
                    android:id="@+id/itemWishlist"
                    layout="@layout/item_setting_row" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- Section: Cài đặt -->
        <TextView
            style="@style/TextAppearance.HealthUp.SubContent.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:text="Cài đặt" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <include
                    android:id="@+id/itemNotification"
                    layout="@layout/item_setting_row" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/neutral_light_grey" />


                <include
                    android:id="@+id/itemLanguage"
                    layout="@layout/item_setting_row" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/neutral_light_grey" />


                <include
                    android:id="@+id/itemAccess"
                    layout="@layout/item_setting_row" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/neutral_light_grey" />


                <include
                    android:id="@+id/itemDeleteAccount"
                    layout="@layout/item_setting_row" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- Section: Liên hệ -->
        <TextView
            style="@style/TextAppearance.HealthUp.SubContent.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:text="Liên hệ" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">


                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_green"
                        android:backgroundTint="@color/primary_tint_5"
                        android:padding="8dp"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/primary_default" />


                    <TextView
                        style="@style/TextAppearance.HealthUp.SubContent.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="0769845728" />
                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/neutral_light_grey" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">


                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_green"
                        android:backgroundTint="@color/primary_tint_5"
                        android:padding="8dp"
                        android:src="@drawable/ic_mail"
                        app:tint="@color/primary_default" />


                    <TextView
                        style="@style/TextAppearance.HealthUp.SubContent.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="healthup@gmail.com" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- Social Icons Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">


            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_facebook" />


            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_instagram" />


            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_threads" />


            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_tiktok" />
        </LinearLayout>


        <Button
            android:id="@+id/btnLogout"
            style="@style/Widget.HealthUp.Button.LargeFilled"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="64dp"
            android:layout_marginTop="24dp"
            android:text="Chuyển tài khoản / Đăng xuất"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold" />


        <TextView
            style="@style/TextAppearance.HealthUp.CaptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Phiên bản: v1.2.3"
            android:textColor="@color/neutral_grey" />


    </LinearLayout>
</androidx.core.widget.NestedScrollView>