<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_cream">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/neutral_black" />

        <TextView
            style="@style/TextAppearance.HealthUp.SubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Thay đổi mật khẩu"
            android:textColor="@color/neutral_black"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Mật khẩu hiện tại -->
            <TextView
                style="@style/TextAppearance.HealthUp.SubContent.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập mật khẩu hiện tại" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_default">

                <EditText
                    android:id="@+id/etCurrentPassword"
                    style="@style/Widget.HealthUp.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Nhập mật khẩu hiện tại"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/ivShowCurrent"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_eye_hide"
                    app:tint="@color/neutral_grey" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvErrorCurrent"
                style="@style/TextAppearance.HealthUp.CaptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mật khẩu hiện tại không chính xác. Vui lòng kiểm tra lại."
                android:textColor="@color/action_error"
                android:visibility="gone" />

            <!-- Mật khẩu mới -->
            <TextView
                style="@style/TextAppearance.HealthUp.SubContent.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nhập mật khẩu mới" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_default">

                <EditText
                    android:id="@+id/etNewPassword"
                    style="@style/Widget.HealthUp.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Nhập mật khẩu mới"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/ivShowNew"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_eye_hide"
                    app:tint="@color/neutral_grey" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvErrorNew"
                style="@style/TextAppearance.HealthUp.CaptionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mật khẩu mới phải có ít nhất 8 ký tự, bao gồm ký tự chữ và ký tự số."
                android:textColor="@color/action_error"
                android:visibility="gone" />

            <!-- Nhập lại mật khẩu mới -->
            <TextView
                style="@style/TextAppearance.HealthUp.SubContent.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nhập lại mật khẩu mới" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_default">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    style="@style/Widget.HealthUp.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Nhập lại mật khẩu mới"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/ivShowConfirm"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_eye_hide"
                    app:tint="@color/neutral_grey" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvErrorConfirm"
                style="@style/TextAppearance.HealthUp.CaptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mật khẩu không trùng khớp. Vui lòng nhập lại."
                android:textColor="@color/action_error"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSave"
                style="@style/Widget.HealthUp.Button.LargeFilled"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:text="Lưu thay đổi"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnForgotPassword"
                style="@style/Widget.HealthUp.Button.LargeOutline"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="Quên mật khẩu"
                android:textAllCaps="false"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
