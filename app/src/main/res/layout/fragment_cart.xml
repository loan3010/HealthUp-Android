<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ===== HEADER kiểu Shopee: Quay lại | Giỏ hàng (n) | Sửa ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingTop="0dp"
        android:paddingBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_cream"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="4dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/text_dark"
            android:contentDescription="@string/cart_back" />

        <TextView
            android:id="@+id/tvCartTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Giỏ hàng"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/tvEditToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/cart_edit"
            android:textSize="14sp"
            android:textColor="@color/green_button"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/guestSyncBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_info"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_info" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/guest_cart_sync_banner"
            android:textColor="@color/green_button"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ===== NỘI DUNG CUỘN: danh sách SP hoặc trạng thái trống + Có thể bạn quan tâm =====
         FIX (bug #6): "Có thể bạn quan tâm" nằm TRONG cùng khối cuộn này nên LUÔN hiển thị
         bất kể giỏ hàng có hay không có sản phẩm — tham khảo đúng hành vi của Shopee. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/guestSyncBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ===== DANH SÁCH SẢN PHẨM ===== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCartItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                tools:listitem="@layout/item_cart" />

            <!-- ===== TRẠNG THÁI GIỎ HÀNG TRỐNG ===== -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:paddingBottom="24dp"
                android:paddingHorizontal="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cart_empty_title"
                    android:textSize="15sp"
                    android:textColor="@color/text_gray"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btnContinueShopping"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="24dp"
                    android:gravity="center"
                    android:text="@string/cart_shop_now"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/bg_button_rounded"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ===== CÓ THỂ BẠN QUAN TÂM (luôn hiển thị) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/may_also_like"
                        android:textColor="@color/neutral_black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvViewAllRecommend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/view_all"
                        android:textColor="@color/neutral_grey"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCartRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_product"
                    tools:spanCount="2" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== FOOTER: LUÔN hiển thị (kể cả giỏ hàng trống) để không chặn luồng người dùng
         (FIX bug #7). Có 2 trạng thái: totalsRow (bình thường) / editRow (chế độ Sửa). ===== -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_cream"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/rowVoucher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:tint="@color/text_gray_light"
                android:src="@drawable/ic_gift"
                android:contentDescription="Voucher" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/cart_voucher_hint"
                android:textSize="13sp"
                android:textColor="@color/green_button" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                app:tint="@color/green_button"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Next" />
        </LinearLayout>

        <!-- ===== Footer chế độ THƯỜNG: Tổng tiền | Quay lại | Tiếp tục ===== -->
        <LinearLayout
            android:id="@+id/totalsRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cart_total"
                    android:textSize="12sp"
                    android:textColor="@color/text_gray" />

                <TextView
                    android:id="@+id/tvTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0đ"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/green_button" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnBackFooter"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:text="@string/cart_back"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/bg_button_rounded"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnCheckout"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:text="Tiếp tục (0)"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/bg_button_rounded"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- ===== Footer chế độ SỬA (giống Shopee): Tất cả | Lưu vào Đã thích | Xóa ===== -->
        <LinearLayout
            android:id="@+id/editRow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/cbSelectAllEdit"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:button="@drawable/cb_custom"
                    app:buttonTint="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/cart_select_all"
                    android:textSize="12sp"
                    android:textColor="@color/text_dark" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSaveToWishlist"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:text="@string/cart_save_to_wishlist"
                android:textColor="@color/green_button"
                android:textSize="13sp"
                android:background="@drawable/bg_button_rounded"
                android:backgroundTint="@color/white"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnDeleteSelected"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:text="@string/cart_delete"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="@drawable/bg_button_rounded"
                android:backgroundTint="@color/error"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>