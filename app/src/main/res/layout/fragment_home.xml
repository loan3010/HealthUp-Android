<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_4xl">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingTop="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/primary_default"
                android:textSize="20sp"
                android:textFontWeight="700"
                tools:targetApi="p" />

            <TextView
                android:id="@+id/tvWelcome"
                style="@style/TextAppearance.HealthUp.SubContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/welcome_back" />

            <TextView
                style="@style/TextAppearance.HealthUp.SubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_question"
                android:textColor="@color/neutral_black" />

            <!-- Search Bar -->
            <LinearLayout
                android:id="@+id/searchBarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/ivSearchIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/neutral_grey" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/spacing_s">

                    <EditText
                        android:id="@+id/etSearch"
                        style="@style/TextAppearance.HealthUp.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textColorHint="@color/neutral_grey"
                        android:textSize="14sp" />

                    <!-- Image Search Preview Container -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/containerImageSearch"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginVertical="8dp"
                        android:visibility="gone"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">
                        <ImageView
                            android:id="@+id/ivSearchPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <ImageView
                    android:id="@+id/ivClearSearch"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:tint="@color/neutral_grey" />

                <ImageView
                    android:id="@+id/ivMic"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:src="@drawable/ic_mic"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/neutral_grey" />

                <ImageView
                    android:id="@+id/ivCamera"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_camera"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/neutral_grey" />
            </LinearLayout>
        </LinearLayout>

        <!-- Container chứa nội dung chính (sẽ ẩn khi tìm kiếm) -->
        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Categories horizontal -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_l"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_category" />

        <!-- Main Banner -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_xl"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/primary_shade_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl">

                    <TextView
                        style="@style/Widget.HealthUp.Badge.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weekly_promo" />

                    <TextView
                        style="@style/TextAppearance.HealthUp.SubTitle"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:text="Granola Giảm 30%\nCho đơn đầu tiên"
                        android:textColor="@color/neutral_white" />

                    <TextView
                        style="@style/TextAppearance.HealthUp.ButtonSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:text="@string/buy_now"
                        android:textColor="@color/neutral_white"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0.3"
                    android:src="@color/primary_shade_3" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Flash Sale Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_2xl"
            android:background="@drawable/bg_flash_sale"
            android:backgroundTint="@color/primary_shade_5"
            android:orientation="vertical"
            android:paddingVertical="@dimen/spacing_m">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_m">

                <TextView
                    android:id="@+id/tvFlashSaleTitle"
                    style="@style/TextAppearance.HealthUp.Content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/flash_sale_title"
                    android:textColor="@color/neutral_white"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Widget.HealthUp.Badge.Hot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_toEndOf="@id/tvFlashSaleTitle"
                    android:backgroundTint="@color/action_error"
                    android:text="-40%"
                    android:textColor="@color/neutral_white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTimerHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_circle_green"
                        android:backgroundTint="@color/primary_default"
                        android:padding="4dp"
                        android:text="02"
                        android:textColor="@color/neutral_white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="2dp"
                        android:text=":"
                        android:textColor="@color/neutral_white" />

                    <TextView
                        android:id="@+id/tvTimerMinute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_circle_green"
                        android:backgroundTint="@color/primary_default"
                        android:padding="4dp"
                        android:text="35"
                        android:textColor="@color/neutral_white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="2dp"
                        android:text=":"
                        android:textColor="@color/neutral_white" />

                    <TextView
                        android:id="@+id/tvTimerSecond"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_circle_green"
                        android:backgroundTint="@color/primary_default"
                        android:padding="4dp"
                        android:text="18"
                        android:textColor="@color/neutral_white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFlashSale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_m"
                    android:scrollbars="horizontal"
                    android:fadeScrollbars="false"
                    android:scrollbarSize="2dp"
                    android:scrollbarThumbHorizontal="@color/primary_tint_3"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_product" />

                <ImageView
                    android:id="@+id/btnFlashSaleLeft"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_circle_green"
                    android:backgroundTint="#80FFFFFF"
                    android:elevation="4dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_back"
                    android:visibility="gone"
                    app:tint="@color/primary_default" />

                <ImageView
                    android:id="@+id/btnFlashSaleRight"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_circle_green"
                    android:backgroundTint="#80FFFFFF"
                    android:elevation="4dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/primary_default" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Sub-categories Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xl"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_l"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipHatDinhDuong"
                    style="@style/Widget.HealthUp.Badge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hạt dinh dưỡng"
                    android:backgroundTint="@color/primary_tint_5" />

                <TextView
                    android:id="@+id/chipGranola"
                    style="@style/Widget.HealthUp.Badge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="Granola"
                    android:backgroundTint="@color/neutral_white"
                    android:textColor="@color/neutral_black" />

                <TextView
                    android:id="@+id/chipTraiCaySay"
                    style="@style/Widget.HealthUp.Badge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="Trái cây sấy"
                    android:backgroundTint="@color/neutral_white"
                    android:textColor="@color/neutral_black" />

                <TextView
                    android:id="@+id/chipDoAnVat"
                    style="@style/Widget.HealthUp.Badge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="Đồ ăn vặt"
                    android:backgroundTint="@color/neutral_white"
                    android:textColor="@color/neutral_black" />

                <TextView
                    android:id="@+id/chipTraThaoMoc"
                    style="@style/Widget.HealthUp.Badge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="Trà thảo mộc"
                    android:backgroundTint="@color/neutral_white"
                    android:textColor="@color/neutral_black" />

                <TextView
                    android:id="@+id/chipCombo"
                    style="@style/Widget.HealthUp.Badge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="Combo"
                    android:backgroundTint="@color/neutral_white"
                    android:textColor="@color/neutral_black" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- New Products Title -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xl"
            android:paddingHorizontal="@dimen/spacing_l">

            <TextView
                style="@style/TextAppearance.HealthUp.SubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_products_title"
                android:textColor="@color/neutral_black" />

            <TextView
                android:id="@+id/tvViewAllNew"
                style="@style/TextAppearance.HealthUp.CaptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/view_all"
                android:textColor="@color/primary_default"
                android:textStyle="bold" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNewProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_s"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:listitem="@layout/item_product" />

        <!-- Blogs Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xl"
            android:paddingHorizontal="@dimen/spacing_l">

            <TextView
                style="@style/TextAppearance.HealthUp.SubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kiến thức sức khỏe"
                android:textColor="@color/neutral_black" />

            <TextView
                android:id="@+id/tvViewAllBlogs"
                style="@style/TextAppearance.HealthUp.CaptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/view_all"
                android:textColor="@color/primary_default"
                android:textStyle="bold" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBlogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_l"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_blog" />

        </LinearLayout>

        <!-- Danh sách kết quả tìm kiếm thời gian thực -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRealtimeSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_s"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:listitem="@layout/item_product" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
