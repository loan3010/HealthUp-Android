<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_cream">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="30dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/neutral_black" />

        <TextView
            style="@style/TextAppearance.HealthUp.SubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Thay đổi số điện thoại"
            android:textColor="@color/neutral_black"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            style="@style/TextAppearance.HealthUp.SubContent.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhập SĐT mới" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_default">

            <EditText
                android:id="@+id/etNewPhone"
                style="@style/Widget.HealthUp.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Nhập SĐT..."
                android:inputType="phone"
                android:paddingEnd="80dp" />

            <TextView
                android:id="@+id/tvGetOtp"
                style="@style/TextAppearance.HealthUp.CaptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:text="Gửi OTP"
                android:textColor="@color/primary_default"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvErrorPhone"
            style="@style/TextAppearance.HealthUp.CaptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Số điện thoại không hợp lệ."
            android:textColor="@color/action_error"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDebugOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/primary_default"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            style="@style/TextAppearance.HealthUp.SubContent.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nhập mã OTP được gửi tới SĐT của bạn" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_default">

            <EditText
                android:id="@+id/etOtp"
                style="@style/Widget.HealthUp.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Nhập mã OTP"
                android:inputType="number" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvErrorOtp"
            style="@style/TextAppearance.HealthUp.CaptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mã OTP không hợp lệ."
            android:textColor="@color/action_error"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.HealthUp.Button.LargeFilled"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="Lưu thay đổi"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
