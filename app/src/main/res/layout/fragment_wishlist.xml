<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_cream">


    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/neutral_cream"
        app:elevation="0dp"
        app:liftOnScroll="false">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="30dp"
            android:paddingHorizontal="16dp">


            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/text_dark" />


            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Yêu thích"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />


            <RelativeLayout
                android:id="@+id/layout_search_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btn_back"
                android:layout_toStartOf="@id/btn_cancel_search"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_search_input"
                android:paddingHorizontal="12dp"
                android:visibility="gone">


                <ImageView
                    android:id="@+id/ic_search_small"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_gray" />


                <EditText
                    android:id="@+id/et_search_wishlist"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/ic_search_small"
                    android:background="@android:color/transparent"
                    android:hint="Tìm kiếm sản phẩm..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:textSize="14sp" />
            </RelativeLayout>


            <TextView
                android:id="@+id/btn_cancel_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Hủy"
                android:textColor="@color/text_dark"
                android:paddingStart="8dp"
                android:visibility="gone" />


            <LinearLayout
                android:id="@+id/layout_header_actions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <ImageButton
                    android:id="@+id/btn_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_search"
                    android:visibility="gone"
                    app:tint="@color/text_dark"
                    tools:visibility="visible" />


                <TextView
                    android:id="@+id/btn_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chỉnh sửa"
                    android:textColor="@color/primary_green"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </RelativeLayout>


        <!-- FIX: đã bỏ HorizontalScrollView chứa 2 chip "Tất cả"/"Đang giảm giá" theo yêu cầu -->


    </com.google.android.material.appbar.AppBarLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">


            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_wishlist_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="60dp"
                android:visibility="gone"
                tools:visibility="visible">


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="70dp"
                    app:cardElevation="0dp">


                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_heart_outline"
                        app:tint="#D1D1D1" />
                </com.google.android.material.card.MaterialCardView>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:paddingHorizontal="40dp"
                    android:text="Bạn chưa chọn thích sản phẩm nào"
                    android:textColor="@color/text_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:paddingHorizontal="40dp"
                    android:text="Hãy khám phá những sản phẩm sức khỏe tuyệt vời và lưu lại tại đây nhé!"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_shop_now"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="@color/primary_green"
                    android:paddingHorizontal="40dp"
                    android:text="Mua sắm ngay"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_cart"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />
            </LinearLayout>


            <!-- List State -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_wishlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:visibility="gone"
                tools:listitem="@layout/item_product"
                tools:spanCount="2"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>


            <!-- Recommendations Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">


                    <TextView
                        android:id="@+id/tv_recommendation_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Có thể bạn quan tâm"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tv_view_all_wishlist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Xem tất cả"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </RelativeLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_wishlist_recommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="10dp"
                    tools:listitem="@layout/item_product"
                    tools:spanCount="2"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>
            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <!-- Selection Bottom Bar (Visible in Edit Mode) -->
    <!-- FIX: đồng bộ layout + màu sắc với thanh "Tất cả | Lưu vào Đã thích | Xóa" của trang
         Giỏ hàng (fragment_cart.xml -> editRow): dùng cùng loại CheckBox (drawable cb_custom,
         24dp, không dùng buttonTint màu xanh mặc định), cùng kiểu nút Xóa (TextView bo góc
         bg_button_rounded + backgroundTint @color/error, cao 40dp) thay vì MaterialCardView
         bo tròn cao 80dp + MaterialButton to bản như trước đây. -->
    <LinearLayout
        android:id="@+id/card_delete_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/neutral_cream"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">


            <CheckBox
                android:id="@+id/cb_select_all_wishlist"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:button="@drawable/cb_custom"
                app:buttonTint="@null" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Tất cả"
                android:textSize="12sp"
                android:textColor="@color/text_dark" />
        </LinearLayout>


        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />


        <TextView
            android:id="@+id/btn_delete_selected"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:text="Xóa (0)"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="@color/error"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>