<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_cream">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/neutral_black" />

        <TextView
            style="@style/TextAppearance.HealthUp.SubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Tài khoản thanh toán"
            android:textColor="@color/neutral_black"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <include layout="@layout/layout_login_required" />

            <!-- Linked Methods Section -->
            <LinearLayout
                android:id="@+id/layoutLinked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.HealthUp.SubContent.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="Phương thức đã liên kết" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLinkedMethods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Empty State Section -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_payment_wallet"
                    app:tint="@color/text_gray_light" />

                <TextView
                    style="@style/TextAppearance.HealthUp.SubContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Chưa có tài khoản liên kết"
                    android:textColor="@color/neutral_black"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Add New Methods Section -->
            <TextView
                android:id="@+id/tvAddSectionTitle"
                style="@style/TextAppearance.HealthUp.SubContent.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="Thêm phương thức mới" />

            <!-- ZaloPay -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAddZalo"
                style="@style/PaymentAddCardStyle">
                <RelativeLayout style="@style/PaymentAddInnerStyle">
                    <ImageView android:id="@+id/ivZAdd" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_zalopay" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivZAdd" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:text="Ví ZaloPay" />
                    <TextView android:id="@+id/btnLinkZalo" style="@style/PaymentLinkButtonStyle" android:text="Liên kết" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- MoMo -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAddMoMo"
                style="@style/PaymentAddCardStyle">
                <RelativeLayout style="@style/PaymentAddInnerStyle">
                    <ImageView android:id="@+id/ivMAdd" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_momo" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivMAdd" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:text="Ví MoMo" />
                    <TextView android:id="@+id/btnLinkMoMo" style="@style/PaymentLinkButtonStyle" android:text="Liên kết" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- VNPay -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAddVnpay"
                style="@style/PaymentAddCardStyle">
                <RelativeLayout style="@style/PaymentAddInnerStyle">
                    <ImageView android:id="@+id/ivVAdd" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_payment_wallet" app:tint="#005BAA" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivVAdd" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:text="VNPay QR" />
                    <TextView android:id="@+id/btnLinkVnpay" style="@style/PaymentLinkButtonStyle" android:text="Liên kết" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- ATM -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAddAtm"
                style="@style/PaymentAddCardStyle">
                <RelativeLayout style="@style/PaymentAddInnerStyle">
                    <ImageView android:id="@+id/ivAAdd" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_bank" app:tint="@color/text_gray" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivAAdd" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:text="Thẻ ATM nội địa" />
                    <TextView android:id="@+id/btnLinkAtm" style="@style/PaymentLinkButtonStyle" android:text="Liên kết" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Linked Bank Account -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAddLinkedBank"
                style="@style/PaymentAddCardStyle">
                <RelativeLayout style="@style/PaymentAddInnerStyle">
                    <ImageView android:id="@+id/ivLBAdd" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_bank" app:tint="@color/green_button" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivLBAdd" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:text="Tài khoản ngân hàng liên kết" />
                    <TextView android:id="@+id/btnLinkBank" style="@style/PaymentLinkButtonStyle" android:text="Liên kết" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Credit Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAddCard"
                style="@style/PaymentAddCardStyle">
                <RelativeLayout style="@style/PaymentAddInnerStyle">
                    <ImageView android:id="@+id/ivCAdd" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_payment_card" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivCAdd" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:text="Thẻ tín dụng / Ghi nợ" />
                    <TextView android:id="@+id/btnLinkCard" style="@style/PaymentLinkButtonStyle" android:text="Thêm" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
