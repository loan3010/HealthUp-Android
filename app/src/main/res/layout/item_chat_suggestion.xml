<?xml version="1.0" encoding="utf-8"?>
<!-- White "suggested questions" card shown near the top of the bot thread. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_bot_avatar">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/chat_avatar_desc"
            android:src="@drawable/ic_chat_bot" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_chat_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_suggestion_title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/suggestionRow1"
            layout="@layout/item_chat_suggestion_row" />

        <include
            android:id="@+id/suggestionRow2"
            layout="@layout/item_chat_suggestion_row" />

        <include
            android:id="@+id/suggestionRow3"
            layout="@layout/item_chat_suggestion_row" />

        <include
            android:id="@+id/suggestionRow4"
            layout="@layout/item_chat_suggestion_row" />

        <TextView
            android:id="@+id/suggestionChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp"
            android:text="@string/chat_suggestion_change"
            android:textColor="@color/brand_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
