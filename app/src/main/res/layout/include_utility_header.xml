<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/utilityHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:background="@color/bg_cream"
    android:paddingTop="30dp"
    android:paddingBottom="8dp"
    android:paddingHorizontal="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/about_back_desc"
        android:src="@drawable/ic_back"
        app:tint="@color/text_dark" />

    <TextView
        android:id="@+id/tv_utility_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Tiêu đề" />

    <LinearLayout
        android:id="@+id/layout_header_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/btn_header_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_circle_white"
            android:elevation="2dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_search"
            app:tint="@color/text_gray" />

        <ImageButton
            android:id="@+id/btn_header_chat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle_white"
            android:elevation="2dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat"
            app:tint="@color/text_gray" />
    </LinearLayout>

</RelativeLayout>
