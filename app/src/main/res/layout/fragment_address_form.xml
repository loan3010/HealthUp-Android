<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_cream"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_dark"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Quay lại" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="40dp"
            android:text="Thêm địa chỉ mới"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/text_dark" />
    </LinearLayout>

    <!-- ===== NỘI DUNG CUỘN ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Họ và tên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Họ và tên"
                android:textSize="13sp"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@drawable/bg_input_normal"
                android:hint="Ví dụ: Nguyễn Văn A"
                android:textColorHint="@color/text_gray_light"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:inputType="textPersonName"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvErrorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vui lòng nhập họ và tên"
                android:textSize="11sp"
                android:textColor="#D32F2F"
                android:visibility="gone" />

            <!-- Số điện thoại -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Số điện thoại"
                android:textSize="13sp"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@drawable/bg_input_normal"
                android:hint="09xx xxx xxx"
                android:textColorHint="@color/text_gray_light"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:inputType="phone"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvErrorPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vui lòng nhập số điện thoại"
                android:textSize="11sp"
                android:textColor="#D32F2F"
                android:visibility="gone" />

            <!-- ĐỊA CHỈ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="ĐỊA CHỈ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray" />

            <!-- Tỉnh/Thành phố -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tỉnh/Thành phố"
                android:textSize="13sp"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/spinnerProvince"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_normal"
                android:paddingStart="12dp"
                android:paddingEnd="40dp"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:hint="Tìm Tỉnh/Thành phố..."
                android:completionThreshold="1" />

            <TextView
                android:id="@+id/tvErrorProvince"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vui lòng chọn tỉnh/thành phố"
                android:textSize="11sp"
                android:textColor="#D32F2F"
                android:visibility="gone" />

            <!-- Quận/Huyện/Phường/Xã -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Quận/Huyện/Phường/Xã"
                android:textSize="13sp"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/spinnerWard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_normal"
                android:paddingStart="12dp"
                android:paddingEnd="40dp"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:hint="Tìm Quận/Huyện/Phường/Xã..."
                android:completionThreshold="1" />

            <TextView
                android:id="@+id/tvErrorWard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vui lòng chọn khu vực"
                android:textSize="11sp"
                android:textColor="#D32F2F"
                android:visibility="gone" />

            <!-- Xóa field District cũ vì JSON chỉ có 2 cấp -->
            <View
                android:id="@+id/spinnerDistrict"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/tvErrorDistrict"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />


            <!-- Địa chỉ cụ thể -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Địa chỉ cụ thể"
                android:textSize="13sp"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDetailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:padding="12dp"
                android:gravity="top|start"
                android:background="@drawable/bg_input_normal"
                android:hint="Địa chỉ cụ thể: số nhà, tên đường..."
                android:textColorHint="@color/text_gray_light"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:inputType="textMultiLine" />

            <TextView
                android:id="@+id/tvErrorDetailAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vui lòng nhập địa chỉ cụ thể"
                android:textSize="11sp"
                android:textColor="#D32F2F"
                android:visibility="gone" />

            <!-- LOẠI ĐỊA CHỈ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="LOẠI ĐỊA CHỈ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTypeHome"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:text="Nhà riêng"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_type_option_selected"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnTypeOffice"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Văn phòng"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:background="@drawable/bg_type_option_unselected"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Đặt làm địa chỉ mặc định -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đặt làm địa chỉ mặc định"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== FOOTER ===== -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_button_outline_green"
            android:text="Xóa"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/green_button"
            android:visibility="gone"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="2"
            android:background="@drawable/bg_button_selector"
            android:text="Hoàn thành"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/white"
            app:backgroundTint="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
