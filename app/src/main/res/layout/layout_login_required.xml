<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutLoginRequired"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/neutral_cream"
    android:visibility="gone">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_loyalty"
        app:tint="@color/primary_default"
        android:alpha="0.5" />

    <TextView
        android:id="@+id/tvLoginRequiredTitle"
        style="@style/TextAppearance.HealthUp.SubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Cần đăng nhập"
        android:textColor="@color/neutral_black"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLoginRequiredMessage"
        style="@style/TextAppearance.HealthUp.SubContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Vui lòng đăng nhập hoặc đăng ký để khám phá đầy đủ tính năng này tại HealthUp."
        android:textColor="@color/neutral_dark_grey" />

    <Button
        android:id="@+id/btnLoginRequired"
        style="@style/Widget.HealthUp.Button.LargeFilled"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="32dp"
        android:text="Đăng nhập / Đăng ký"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnLater"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:text="Để sau"
        android:textColor="@color/primary_default"
        android:textSize="14sp" />

</LinearLayout>
