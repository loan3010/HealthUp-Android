<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="53dp"
        android:paddingTop="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_cream"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/phone_verification_back_to_cart"
            app:tint="@color/text_dark" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="40dp"
            android:text="Xác minh số điện thoại"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/text_dark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vui lòng nhập số điện thoại của bạn để chúng tôi có thể gửi mã xác nhận và cập nhật trạng thái đơn hàng nhanh nhất."
            android:textSize="14sp"
            android:textColor="@color/text_gray"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số điện thoại"
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutInputPhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_normal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/ivPhoneIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_phone"
                app:tint="@color/text_gray_light" />

            <TextView
                android:id="@+id/tvPrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+84"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="0xxx xxx xxx"
                android:textColorHint="@color/text_gray_light"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:inputType="text"
                android:digits="0123456789"
                android:maxLength="10"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tvChangePhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thay đổi"
                android:textColor="@color/green_primary"
                android:textSize="13sp"
                android:padding="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvErrorPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số điện thoại không đúng định dạng"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Box trạng thái tài khoản -->
        <LinearLayout
            android:id="@+id/layoutStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_info"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tài khoản đã tồn tại."
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStatusDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số điện thoại đã được đăng ký. Vui lòng đăng nhập để tiếp tục mua hàng với các ưu đãi dành riêng cho thành viên."
                android:textColor="@color/text_gray"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_rounded"
            android:text="Tiếp tục"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/tvBackToShopping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:padding="4dp"
            android:text="@string/phone_verification_back_to_cart"
            android:textSize="13sp"
            android:textColor="@color/green_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Box gợi ý đăng nhập dưới cùng -->
        <LinearLayout
            android:id="@+id/layoutBottomHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_info"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_info" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Nếu bạn đã có tài khoản, vui lòng đăng nhập để nhận các ưu đãi và tích điểm dành riêng cho thành viên."
                android:textSize="12sp"
                android:textColor="@color/text_gray" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
