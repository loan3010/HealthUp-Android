<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_messenger_bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/chatHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/chatBack"
            android:layout_width="40dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_back"
            android:padding="8dp"
            android:src="@drawable/ic_chat_back" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_bot_avatar">

                <ImageView
                    android:id="@+id/imgBotAvatar"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/chat_avatar_desc"
                    android:src="@drawable/ic_chat_bot" />
            </FrameLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center|bottom|end"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_online_dot" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_title"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_status_online"
                android:textColor="@color/chat_header_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chatMore"
            android:layout_width="40dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_menu"
            android:padding="8dp"
            android:src="@drawable/ic_chat_more" />

    </LinearLayout>

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_chat_message" />

    <!-- Quick reply chips -->
    <HorizontalScrollView
        android:id="@+id/chatQuickChipsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipOrderStatus"
                style="@style/ChatQuickChip"
                android:text="@string/chat_q_order_status" />

            <TextView
                android:id="@+id/chipCancelOrder"
                style="@style/ChatQuickChip"
                android:layout_marginStart="8dp"
                android:text="@string/chat_q_cancel_order" />

            <TextView
                android:id="@+id/chipSeller"
                style="@style/ChatQuickChip"
                android:layout_marginStart="8dp"
                android:text="@string/chat_quick_seller" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Input bar -->
    <LinearLayout
        android:id="@+id/chatInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/chatAttach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_attach"
            android:padding="8dp"
            android:src="@drawable/ic_chat_add" />

        <EditText
            android:id="@+id/chatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input_field"
            android:hint="@string/chat_input_hint"
            android:imeOptions="actionSend|flagNoEnterAction"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/placeholder"
            android:textSize="15sp"
            android:importantForAutofill="no" />

        <FrameLayout
            android:id="@+id/chatSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:clickable="false"
                android:contentDescription="@string/chat_send"
                android:focusable="false"
                android:src="@drawable/ic_chat_send" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
