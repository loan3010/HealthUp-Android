rules_version = '2';

// ---------------------------------------------------------------------------
// HealthUp – Firestore security rules (merged)
// Deploy: Firebase Console → Firestore → Rules → Publish
//     hoặc: firebase deploy --only firestore:rules
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function resolveRoleFromData(data) {
      return 'role' in data && data.role is string
        ? data.role
        : ('userRole' in data && data.userRole is string ? data.userRole : null);
    }

    function resolveRoleForUserDoc(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath)
        ? resolveRoleFromData(get(userPath).data)
        : null;
    }

    function currentRole() {
      // users/{uid}.role — or linked profile via user_sessions (admin Auth UID mismatch).
      return isSignedIn()
        ? (resolveRoleForUserDoc(request.auth.uid)
            != null
            ? resolveRoleForUserDoc(request.auth.uid)
            : (linkedProfileDocId() != null
                ? resolveRoleForUserDoc(linkedProfileDocId())
                : null))
        : null;
    }

    function isStaff() {
      // Sellers, admins, and staff can manage orders / write buyer notifications.
      return currentRole() in ['seller', 'admin', 'staff'];
    }

    function linkedProfileDocId() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/user_sessions/$(request.auth.uid))
        ? get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.profileDocId
        : null;
    }

    function ownsConversationBuyerId(buyerId) {
      return isSignedIn()
        && (request.auth.uid == buyerId
            || (linkedProfileDocId() != null && linkedProfileDocId() == buyerId));
    }

    function isParticipant(convData) {
      return isSignedIn()
        && (ownsConversationBuyerId(convData.buyerId)
            || (convData.participantIds is list
                && request.auth.uid in convData.participantIds));
    }

    // After password_reset OTP verified: allow updating app password hash (no Auth/Cloud).
    function isPasswordResetHashUpdate(userId) {
      let userPhone = get(/databases/$(database)/documents/users/$(userId)).data.phone;
      let localPhone = userPhone is string ? userPhone : '';
      return localPhone.matches('^0[0-9]{9}$')
        && exists(/databases/$(database)/documents/password_reset/$(localPhone))
        && get(/databases/$(database)/documents/password_reset/$(localPhone)).data.verified == true
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['passwordHash', 'passwordAuthMode'])
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordAuthMode == 'app';
    }

    function isAdminPasswordResetHashUpdate(userId) {
      let userData = get(/databases/$(database)/documents/users/$(userId)).data;
      let role = 'role' in userData && userData.role is string
        ? userData.role
        : ('userRole' in userData && userData.userRole is string ? userData.userRole : '');
      return role == 'admin'
        && exists(/databases/$(database)/documents/admin_password_reset/$(userId))
        && get(/databases/$(database)/documents/admin_password_reset/$(userId)).data.verified == true
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['passwordHash', 'passwordAuthMode'])
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordAuthMode == 'app';
    }

    // --- Users ------------------------------------------------------------
    match /users/{userId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId)
                    || isPasswordResetHashUpdate(userId)
                    || isAdminPasswordResetHashUpdate(userId)
                    || (currentRole() == 'admin'
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['disabled', 'updatedAt', 'disabledReason', 'disabledAt', 'unlockedReason', 'unlockedAt']));
      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /cart/{cartItemId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /wishlist/{productId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        // Owner can read/update/delete; owner or staff can create (order status alerts).
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isStaff()
                      || (isSignedIn() && request.auth.uid == userId);
      }

      match /addresses/{addressId} {
        allow read, write: if (isSignedIn() && request.auth.uid == userId) || userId == "guest_user";
      }

      // Diet: per-dish saves (current feature)
      match /savedDishes/{dishId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Diet: legacy whole-day meal plans (backward compat — read/delete old data only)
      match /savedMealPlans/{planId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- Pre-auth OTP (registration + password reset, Spark / no Cloud Functions) ---
    match /registration_otp/{phone} {
      allow read, write: if phone is string;
    }

    match /password_reset/{phone} {
      allow read, write: if phone is string;
    }

    match /admin_password_reset/{adminUid} {
      allow read, write: if adminUid is string;
    }

    // Email OTP (Spark — không phụ thuộc Firebase Auth email delivery)
    match /email_verification/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Buyer checkout: StockManager may only change inventory / sold counters.
    // Include `sold` — client writes product-level sold after deduct/restore.
    // (sold inside variants[] is covered by the `variants` key itself.)
    function isStockOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'stockCount', 'variants', 'sold', 'soldCount']);
    }

    // --- Catalog / demo content (student project) -------------------------
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isStaff();
      // Prefer tight inventory updates over wide-open isSignedIn() product edits.
      allow update: if isStaff()
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['favorite']))
                    || (isSignedIn() && isStockOnlyUpdate());

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn()
                              && resource.data.userId == request.auth.uid;
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // "policies" là nội dung hiển thị cho user xem (đăng nhập hoặc chưa),
    // nên read mở công khai. Việc tạo/sửa nội dung do admin/seller quản lý
    // qua Firebase Console hoặc Admin SDK (bypass rules) — KHÔNG mở write
    // cho client để tránh ai đó chỉnh sửa/xoá nội dung chính sách.
    match /policies/{policyId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Voucher / mã giảm giá (CheckoutFragment, PromoCouponFragment, FirebaseManager.getVouchers)
    match /promoCodes/{promoCodeId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // AdminProductCodeHelper — auto-increment HEALTHUP-xxxx codes
    match /meta/{docId} {
      allow read, write: if isStaff();
    }

    function isOrderOwner() {
      return isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.userId == request.auth.uid
            || linkedProfileOwnsOrder());
    }

    function linkedProfileOwnsOrder() {
      return exists(/databases/$(database)/documents/user_sessions/$(request.auth.uid))
        && (resource.data.buyerId
              == get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.profileDocId
            || resource.data.userId
              == get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.profileDocId);
    }

    function ownsOrderId(orderId) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return isSignedIn()
        && (order.buyerId == request.auth.uid
            || order.userId == request.auth.uid
            || (exists(/databases/$(database)/documents/user_sessions/$(request.auth.uid))
                && (order.buyerId
                      == get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.profileDocId
                    || order.userId
                      == get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.profileDocId)));
    }

    // --- User sessions ------------------------------------------------------
    match /user_sessions/{authUid} {
      allow read, write: if isSignedIn() && request.auth.uid == authUid;
    }

    match /cart/{cartItemId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
                            && resource.data.userId == request.auth.uid;
    }

    // --- Orders -----------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isOrderOwner() || isStaff();
      allow create: if isSignedIn()
                    && (request.resource.data.buyerId == request.auth.uid
                        || request.resource.data.userId == request.auth.uid);
      // Cho phép chủ đơn hàng HOẶC nhân viên được cập nhật (để hủy đơn, xác nhận đã nhận...)
      allow update: if isOrderOwner() || isStaff();
      // Chỉ nhân viên mới được xóa đơn hàng khỏi database
      allow delete: if isStaff();

      // Lịch sử đơn hàng — staff hoặc chủ đơn (hủy / nhận hàng / trả hàng)
      match /history/{historyId} {
        allow read: if isStaff() || ownsOrderId(orderId);
        allow create: if isStaff() || ownsOrderId(orderId);
      }
    }

    // Admin inbox (customer cancel, etc.) — staff read; signed-in users can create
    match /admin_notifications/{notificationId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    // --- Conversations ----------------------------------------------------
    match /conversations/{conversationId} {
      allow read: if isStaff()
                  || (resource == null && isSignedIn())
                  || (resource != null && isParticipant(resource.data));

      allow create: if isSignedIn()
                    && ownsConversationBuyerId(request.resource.data.buyerId);

      allow update: if isParticipant(resource.data) || isStaff();

      allow delete: if isStaff();

      match /messages/{messageId} {
        function convData() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isParticipant(convData()) || isStaff();

        allow create: if isSignedIn()
                      && (isParticipant(convData()) || isStaff())
                      && request.resource.data.senderId == request.auth.uid;

        allow update: if (isParticipant(convData()) || isStaff());
        allow delete: if false;
      }
    }
  }
}
